            <li><a href="/scholarship-opportunities">Scholarship</a></li>
            <li><a href="#">News &amp; Updates</a></li>
          </ul>
        </div>

        <div class="ending">
          <p class="article-title">Our Contacts</p>
          <p>(+237) 677-777-177<br />(+237) 699-009-988</p>
          <p>
            Email: <a href="mailto:hehipeds@gmail.com">hehipeds@gmail.com</a>
          </p>
        </div>

        <div class="ending">
          <p class="article-title">Follow Us</p>
          <p>Facebook: <a href="#">Heritageforpeace</a></p>
